{
  "functions": {
    "api/generate-pdf.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/rapport-to-portail.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/sync-reservations.js": {
      "maxDuration": 300
    },
    "api/sync-biens.js": {
      "maxDuration": 60
    },
    "api/sync-proprietaires.js": {
      "maxDuration": 60
    },
    "api/sync-payouts.js": {
      "maxDuration": 120
    },
    "api/matching-auto.js": {
      "maxDuration": 120
    },
    "api/pennylane-mouvement-sync.js": {
      "maxDuration": 60
    },
    "api/pennylane-courant-sync.js": {
      "maxDuration": 60
    },
    "api/pennylane-lld-sync.js": {
      "maxDuration": 60
    },
    "api/lld-auto.js": {
      "maxDuration": 120
    },
    "api/pennylane-achats-statut.js": {
      "maxDuration": 60
    },
    "api/webhook-hospitable.js": {
      "maxDuration": 120
    },
    "api/sync-stripe.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/sync-proprietaires?agence=dcb",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/sync-proprietaires?agence=lauian",
      "schedule": "35 2 * * *"
    },
    {
      "path": "/api/sync-biens?agence=dcb",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/sync-biens?agence=lauian",
      "schedule": "45 2 * * *"
    },
    {
      "path": "/api/sync-reservations?agence=dcb&offset=-1",
      "schedule": "50 2 * * *"
    },
    {
      "path": "/api/sync-reservations?agence=lauian&offset=-1",
      "schedule": "55 2 * * *"
    },
    {
      "path": "/api/sync-reservations?agence=dcb&offset=0",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/sync-reservations?agence=dcb&offset=1",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/sync-reservations?agence=dcb&offset=2",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/sync-reservations?agence=lauian&offset=0",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/sync-reservations?agence=lauian&offset=1",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/sync-reservations?agence=lauian&offset=2",
      "schedule": "25 3 * * *"
    },
    {
      "path": "/api/sync-payouts",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/matching-auto",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/sync-stripe",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/pennylane-mouvement-sync",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/api/pennylane-courant-sync",
      "schedule": "52 3 * * *"
    },
    {
      "path": "/api/pennylane-lld-sync",
      "schedule": "55 3 * * *"
    },
    {
      "path": "/api/lld-auto",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/pennylane-achats-statut",
      "schedule": "5 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
